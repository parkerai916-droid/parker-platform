#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'Parker ingestion failed: %s\n' "$1" >&2
    exit 1
}

[[ "$(hostname)" == "hermes" ]] || die "this wrapper must run on hostname hermes"
[[ $# -ge 1 ]] || die "usage: ./parker-ingest-folder <folder> --batch <Parker-batch>"
SOURCE_FOLDER=$1
shift
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null) || die "not inside a Parker git repository"
[[ "$REPO_ROOT" == "$SCRIPT_DIR" ]] || die "parker-ingest-folder must be in the Parker repository root"
BATCH_ID=
GATEWAY_URL=${PARKER_GATEWAY_URL:-http://192.168.178.44:8090}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --batch) [[ $# -ge 2 ]] || die "--batch requires a Parker-minted batch ID"; BATCH_ID=$2; shift 2 ;;
        --case-id) die "--case-id belongs to the superseded parker_bulk_ingest path; select a Parker-authorised batch instead" ;;
        --gateway) [[ $# -ge 2 ]] || die "--gateway requires a URL"; GATEWAY_URL=$2; shift 2 ;;
        *) die "unknown option: $1" ;;
    esac
done

[[ -n "$BATCH_ID" ]] || die "--batch is required; Hermes will never invent a batch ID"
[[ "$BATCH_ID" =~ ^bulk-[a-f0-9-]+$ ]] || die "--batch must be a Parker-minted batch ID"
[[ -d "$SOURCE_FOLDER" ]] || die "source folder is not a directory: $SOURCE_FOLDER"
SOURCE_FOLDER=$(cd -- "$SOURCE_FOLDER" && pwd)
cd "$REPO_ROOT"

if [[ -z "${PARKER_AGENT_GATEWAY_TOKEN:-}" ]]; then
    TOKEN_FILE=${HERMES_PARKER_TOKEN_FILE:-"$HOME/.hermes/parker-agent-gateway-token"}
    [[ -f "$TOKEN_FILE" ]] || die "PARKER_AGENT_GATEWAY_TOKEN is unset and token file is missing"
    token_mode=$(stat -c '%a' "$TOKEN_FILE" 2>/dev/null) || die "cannot inspect token file permissions"
    (( (8#$token_mode & 0177) == 0 )) || die "Parker Agent Gateway token file permissions are broader than 0600"
    IFS= read -r PARKER_AGENT_GATEWAY_TOKEN < "$TOKEN_FILE" || die "cannot read Parker Agent Gateway token file"
fi
[[ -n "${PARKER_AGENT_GATEWAY_TOKEN:-}" ]] || die "Parker Agent Gateway token is empty"
export PARKER_AGENT_GATEWAY_TOKEN

# Authoritative path: Hermes owns inspection/processing and Parker owns the
# governed source admission and persisted processing state.
exec python3 "$REPO_ROOT/tools/hermes_processing_ingest.py" \
    --input "$SOURCE_FOLDER" --batch "$BATCH_ID" --gateway-url "$GATEWAY_URL" --yes
