# Copy to .env and adjust before running `docker compose up`.
# Every value here has a default in docker-compose.yml except
# PARKER_OWNER_PRINCIPAL_ID, which compose refuses to start without.

# --- Owner LAN Evidence Upload (optional, off by default) ----------------
# Lets the owner, from a browser on a Windows laptop on the same trusted
# LAN as this headless server, upload evidence files and drive Tier A/B
# processing -- no X11, desktop environment, or graphical session on the
# server. Uncomment BOTH lines below to enable it (docker-compose.yml
# requires them set together or not at all); leave both commented out and
# nothing changes about this deployment.
#
# PARKER_OWNER_HTTP_PORT=8080
# PARKER_OWNER_HTTP_TOKEN=replace-with-a-real-random-secret-you-generate-locally

# --- Ollama connectivity -------------------------------------------------
# This deployment uses Ollama already running on the host, not a
# container this compose project manages. PARKER_MODEL_ENDPOINT_URL is
# fixed in docker-compose.yml to http://host.docker.internal:11434/api/generate
# (not configurable here) -- host.docker.internal is mapped to the host
# via the `extra_hosts: host-gateway` entry there. Only the model name is
# configurable:
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Parker Runtime configuration ---------------------------------------
PARKER_MODEL_TIMEOUT_MS=30000
PARKER_OWNER_PRINCIPAL_ID=user.owner
PARKER_OWNER_DISPLAY_NAME=Owner
PARKER_LOCAL_TEXT_CHANNEL_MODULE_ID=channel.local-text

# Console log display threshold: DEBUG, INFO, WARN, ERROR, or OFF. Filters
# which lines are printed -- audit/execution/permission events are still
# produced regardless of this setting, only their console visibility
# changes.
#
# If left unset (or blank), the *default* is mode-sensitive, resolved by
# Main.kt at startup, not by this value alone: INFO for the normal,
# detached/headless service; WARN for `--interactive` (so the owner-facing
# terminal stays clean of routine INFO/DEBUG noise while still surfacing
# real problems). Setting PARKER_LOG_LEVEL explicitly here always wins,
# in either mode.
PARKER_LOG_LEVEL=INFO
