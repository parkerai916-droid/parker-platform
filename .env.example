# Copy to .env and adjust before running `docker compose up`.
# Every value here has a default in docker-compose.yml except
# PARKER_OWNER_PRINCIPAL_ID, which compose refuses to start without.

# --- Owner LAN Evidence Upload (optional, off by default) ----------------
# Lets the owner, from a browser on a Windows laptop on the same trusted
# LAN as this headless server, upload evidence files and drive Tier A/B
# processing -- no X11, desktop environment, or graphical session on the
# server. Uncomment BOTH lines below to enable it (docker-compose.yml
# requires them set together or not at all); leave both commented out and
# nothing changes about this deployment.
#
# PARKER_OWNER_HTTP_PORT=8080
# Browser bearer tokens are retired; pairing/device/session state uses PARKER_OWNER_UI_AUTHENTICATION_ROOT.

# --- Parker Agent Gateway (optional, off by default) ---------------------
# Lets the Hermes VM, on the same trusted local network as this headless
# server, connect over its own separate, authenticated HTTP surface --
# structurally independent of Owner LAN Evidence Upload above (own bind
# address, port, and bearer token; never Owner's). Uncomment all three
# lines below to open the port (docker-compose.yml requires them set
# together or not at all); leave them commented out and nothing changes
# about this deployment. Opening the port alone grants Hermes nothing --
# see PARKER_AGENT_GATEWAY_HERMES_ACTIVE below for the separate,
# additional step that does.
#
# PARKER_AGENT_GATEWAY_HTTP_PORT=8090
# PARKER_AGENT_GATEWAY_HTTP_BIND_ADDRESS=0.0.0.0
# Deployment-local secret only; generate your own, never commit a value.
# PARKER_AGENT_GATEWAY_HTTP_TOKEN=

# Production Hermes activation (off by default). Hermes's own Principal
# (agent.hermes-ingestion-operator) is always registered at startup
# regardless of this setting; only this explicit flag additionally
# transitions it to ACTIVE, granting it whatever the existing, unmodified
# Agent Gateway permission rules already allow. Requires
# PARKER_AGENT_GATEWAY_HTTP_PORT above to also be set. Leave unset (or
# false) until you are actually ready for the Hermes VM to reach this
# deployment.
# PARKER_AGENT_GATEWAY_HERMES_ACTIVE=false

# --- Ollama connectivity -------------------------------------------------
# This deployment uses Ollama already running on the host, not a
# container this compose project manages. PARKER_MODEL_ENDPOINT_URL is
# fixed in docker-compose.yml to http://host.docker.internal:11434/api/generate
# (not configurable here) -- host.docker.internal is mapped to the host
# via the `extra_hosts: host-gateway` entry there. Only the model name is
# configurable:
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Parker Runtime configuration ---------------------------------------
PARKER_MODEL_TIMEOUT_MS=30000
PARKER_OWNER_PRINCIPAL_ID=user.owner
PARKER_OWNER_DISPLAY_NAME=Owner
PARKER_LOCAL_TEXT_CHANNEL_MODULE_ID=channel.local-text

# Console log display threshold: DEBUG, INFO, WARN, ERROR, or OFF. Filters
# which lines are printed -- audit/execution/permission events are still
# produced regardless of this setting, only their console visibility
# changes.
#
# If left unset (or blank), the *default* is mode-sensitive, resolved by
# Main.kt at startup, not by this value alone: INFO for the normal,
# detached/headless service; WARN for `--interactive` (so the owner-facing
# terminal stays clean of routine INFO/DEBUG noise while still surfacing
# real problems). Setting PARKER_LOG_LEVEL explicitly here always wins,
# in either mode.
PARKER_LOG_LEVEL=INFO

# --- OpenAI external transcription readiness (disabled by default) -------
# This is credential-free configuration only. Enabling also requires a
# current deployment-local reviewed provider profile. No API key belongs
# in this profile or in Unit F configuration.
# PARKER_OPENAI_EXTERNAL_TRANSCRIPTION_ENABLED=false
# PARKER_OPENAI_EXTERNAL_TRANSCRIPTION_PROVIDER_PROFILE_PATH=/run/parker/openai-transcription-profile.properties
# Deployment-local secret only; leave unset while disabled. Never commit a value.
# PARKER_OPENAI_API_KEY=
